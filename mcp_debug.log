SEND: {"jsonrpc": "2.0", "id": 10, "result": {"content": [{"type": "text", "text": "--- FILE: /data/data/com.termux/files/home/Projects/agy-nodeos/daemon.py (250 lines) ---\n   1 | #!/data/data/com.termux/files/usr/bin/python3\n   2 | import asyncio\n   3 | import os\n   4 | import sys\n   5 | \n   6 | import subprocess\n   7 | import threading\n   8 | import json\n   9 | from multiprocessing.connection import Listener\n  10 | \n  11 | from graph_manager import AGYGraphManager\n  12 | from jage_engine import JageASTEngine\n  13 | from nodes_engine import NativeNodesEngine\n  14 | \n  15 | class AGYRawWatchdog:\n  16 |     \"\"\"\n  17 |     ZERO-DEPENDENCY RAW FILE OBSERVER\n  18 |     Eliminates the need for 'pip install watchdog'. Uses lightweight asyncio polling.\n  19 |     \"\"\"\n  20 |     def __init__(self, directory, callback, interval=1.0):\n  21 |         self.directory = directory\n  22 |         self.callback = callback\n  23 |         self.interval = interval\n  24 |         self.state = {}\n  25 |         self.running = False\n  26 |         self._initialize_state()\n  27 | \n  28 |     def _should_ignore(self, path):\n  29 |         # Ignore internal OS state folders and dependencies to prevent recursive loops and bloat\n  30 |         ignores = ['.jsagent', '.agents', '__pycache__', '.git', 'node_modules', 'build', 'dist', '.venv', 'venv', '.build_cache', 'site-packages', 'env']\n  31 |         return any(ign in path for ign in ignores)\n  32 | \n  33 |     def _initialize_state(self):\n  34 |         for root, _, files in os.walk(self.directory):\n  35 |             if self._should_ignore(root):\n  36 |                 continue\n  37 |             for file in files:\n  38 |                 if file.endswith(('.py', '.json')):\n  39 |                     path = os.path.join(root, file)\n  40 |                     self.state[path] = os.stat(path).st_mtime\n  41 | \n  42 |     async def start(self):\n  43 |         self.running = True\n  44 |         print(f\"[Raw Watchdog] Natively polling {self.directory} every {self.interval}s...\")\n  45 |         while self.running:\n  46 |             await asyncio.sleep(self.interval)\n  47 |             for root, _, files in os.walk(self.directory):\n  48 |                 if self._should_ignore(root):\n  49 |                     continue\n  50 |                 for file in files:\n  51 |                     if file.endswith(('.py', '.json')):\n  52 |                         path = os.path.join(root, file)\n  53 |                         try:\n  54 |                             mtime = os.stat(path).st_mtime\n  55 |                             if path not in self.state or mtime > self.state[path]:\n  56 |                                 self.state[path] = mtime\n  57 |                                 self.callback(path)\n  58 |                         except FileNotFoundError:\n  59 |                             pass\n  60 | \n  61 | class AGYNodeOSEventHandler:\n  62 |     def __init__(self, jage, spatial, graph, loop):\n  63 |         self.jage = jage\n  64 |         self.spatial = spatial\n  65 |         self.graph = graph\n  66 |         self.loop = loop\n  67 | \n  68 |     def on_modified(self, filepath):\n  69 |         print(f\"\\n[Daemon] Detected modification in: {filepath}\")\n  70 |         \n  71 |         if filepath.endswith('.json'):\n  72 |             print(f\"[Event Loop] Picked up agent JSON workflow from {filepath}!\")\n  73 |             asyncio.run_coroutine_threadsafe(\n  74 |                 self.dispatch_workflow([{'hash': 'workflow', 'type': 'JSON_Task', 'file': filepath}]), self.loop\n  75 |             )\n  76 |             return\n  77 |         \n  78 |         ast_nodes = self.jage.parse_file(filepath)\n  79 |         if ast_nodes:\n  80 |             for node in ast_nodes:\n  81 |                 self.spatial.add_node(node['hash'], node['type'])\n  82 | \n  83 |     async def dispatch_workflow(self, nodes):\n  84 |         \"\"\"True Swarm Dispatcher: Parses JSON and emits intents for AGY Agents to execute, acting as the state manager.\"\"\"\n  85 |         for node in nodes:\n  86 |             if node['type'] == 'JSON_Task':\n  87 |                 workflow_file = node['file']\n  88 |                 try:\n  89 |                     with open(workflow_file, 'r') as f:\n  90 |                         workflow = json.load(f)\n  91 |                     \n  92 |                     status = workflow.get('status')\n  93 |                     \n  94 |                     if status == 'pending':\n  95 |                         # Handle native Re-Stitch action requested by an agent\n  96 |                         if workflow.get('action') == 'stitch':\n  97 |                             print(f\"[Swarm Dispatcher] Processing Re-Stitch request for hash {workflow.get('node_hash')[:8]}...\")\n  98 |                             workflow['status'] = 'running'\n  99 |                             with open(workflow_file, 'w') as f: json.dump(workflow, f, indent=4)\n 100 |                             \n 101 |                             result = self.jage.re_stitch(workflow.get('node_hash'), workflow.get('new_source'))\n 102 |                             \n 103 |                             if result is True:\n 104 |                                 workflow['status'] = 'completed'\n 105 |                             else:\n 106 |                                 workflow['status'] = 'failed_qa'\n 107 |                                 workflow['error_log'] = result\n 108 |                                 print(f\"[Swarm Feedback Loop] Sent QA failure back to agent: {result}\")\n 109 |                                 \n 110 |                             with open(workflow_file, 'w') as f: json.dump(workflow, f, indent=4)\n 111 |                             print(f\"[Event Loop] Jage Re-Stitch workflow completed.\")\n 112 |                             continue\n 113 |                             \n 114 |                         # Handle Swarm Agent execution\n 115 |                         agent_list = workflow.get('agents', [])\n 116 |                         print(f\"[Swarm Dispatcher] Emitting Swarm intent for AGY external swarm: {agent_list}\")\n 117 |                         print(f\"[Swarm Dispatcher] Actively spawning AGY CLI Subprocess...\")\n 118 |                         \n 119 |                         # Active AGY CLI Subprocessing\n 120 |                         prompt = f\"System OS Alert: A workflow intent '{workflow.get('action')}' has been requested. Required agents: {agent_list}. Please fulfill this workflow by acting as the requested agents. When finished, update {workflow_file} status to 'completed'.\"\n 121 |                         cmd = f'agy --print \"{prompt}\"'\n 122 |                         \n 123 |                         # Run the shell command asynchronously so it doesn't block the daemon\n 124 |                         async def spawn_agent():\n 125 |                             process = await asyncio.create_subprocess_shell(\n 126 |                                 cmd,\n 127 |                                 stdout=asyncio.subprocess.PIPE,\n 128 |                                 stderr=asyncio.subprocess.PIPE\n 129 |                             )\n 130 |                             stdout, stderr = await process.communicate()\n 131 |                             if stderr:\n 132 |                                 print(f\"[Swarm Dispatcher] AGY CLI Warning: {stderr.decode('utf-8').strip()}\")\n 133 |                             print(f\"[Swarm Dispatcher] AGY CLI Subprocess execution finished.\")\n 134 |                             \n 135 |                         asyncio.create_task(spawn_agent())\n 136 |                     \n 137 |                     elif status == 'running':\n 138 |                         print(f\"[Swarm Dispatcher] AGY Swarm has picked up the task. Monitoring execution...\")\n 139 |                         \n 140 |                     elif status == 'completed':\n 141 |                         print(f\"[Event Loop] Swarm workflow fully executed by AGY agents.\")\n 142 |                         \n 143 |                     elif status == 'failed_execution' or status == 'failed_qa':\n 144 |                         print(f\"[Swarm Error] AGY Workflow failed. Awaiting human or agent intervention.\")\n 145 |                         \n 146 |                 except Exception as e:\n 147 |                     print(f\"[Swarm Error] Failed to process workflow state: {e}\")\n 148 | \n 149 | class AGYDaemon:\n 150 |     def __init__(self, workspace_dir):\n 151 |         self.workspace = workspace_dir\n 152 |         self.graph = AGYGraphManager()\n 153 |         self.jage = JageASTEngine()\n 154 |         self.spatial = NativeNodesEngine()\n 155 |         self.loop = asyncio.new_event_loop()\n 156 |         \n 157 |         self.event_handler = AGYNodeOSEventHandler(self.jage, self.spatial, self.graph, self.loop)\n 158 |         \n 159 |         # Initialize our zero-dependency raw watchdog\n 160 |         self.raw_watchdog = AGYRawWatchdog(self.workspace, self.event_handler.on_modified, interval=1.0)\n 161 |         \n 162 |         self.ipc_thread = threading.Thread(target=self.start_ipc_server, daemon=True)\n 163 |         self.ipc_thread.start()\n 164 | \n 165 |     def start_ipc_server(self):\n 166 |         address = ('localhost', 6000)\n 167 |         try:\n 168 |             with Listener(address, authkey=b'agy-nodeos-secret') as listener:\n 169 |                 while True:\n 170 |                     with listener.accept() as conn:\n 171 |                         msg = conn.recv()\n 172 |                         if msg == 'ping':\n 173 |                             conn.send('pong: OS Daemon is alive and running invisibly.')\n 174 |                         elif msg == 'status':\n 175 |                             conn.send(f'Active Workflows: OK | Watchdog: {self.workspace}')\n 176 |                         else:\n 177 |                             conn.send('unknown_syscall')\n 178 |         except OSError:\n 179 |             print(\"[System] IPC Address 6000 already in use. A daemon is already running! Terminating duplicate process.\")\n 180 |             os._exit(1)\n 181 | \n 182 |     def cold_start_ingestion(self):\n 183 |         if len(self.spatial.all_nodes) == 0:\n 184 |             print(\"[NodeOS] Detected Uninitialized Project Workspace. Initiating Deep Ingestion...\")\n 185 |             # 1. Deep scan the workspace\n 186 |             for root, _, files in os.walk(self.workspace):\n 187 |                 if self.raw_watchdog._should_ignore(root):\n 188 |                     continue\n 189 |                 for file in files:\n 190 |                     if file.endswith(('.py', '.js', '.ts')):\n 191 |                         filepath = os.path.join(root, file)\n 192 |                         ast_nodes = self.jage.parse_file(filepath)\n 193 |                         if ast_nodes:\n 194 |                             for node in ast_nodes:\n 195 |                                 # We now pass the node name and the calls it makes to the spatial matrix\n 196 |                                 self.spatial.add_node(node['hash'], node['type'], node.get('name', 'unknown'), node.get('calls', []))\n 197 |             \n 198 |             # Resolve physical edges using AST calls\n 199 |             self.spatial.resolve_edges()\n 200 |             \n 201 |             print(f\"[NodeOS] Deep Scan complete. Ingested {len(self.spatial.all_nodes)} kinetic nodes.\")\n 202 |             \n 203 |             # 2. Check for missing Architectural Nodes\n 204 |             architect_exists = os.path.exists(os.path.join(self.workspace, \"architect_parent_node.md\"))\n 205 |             blueprint_exists = os.path.exists(os.path.join(self.workspace, \"impl_blueprint_node.md\"))\n 206 |             \n 207 |             if not architect_exists or not blueprint_exists:\n 208 |                 print(\"[NodeOS] Essential structural nodes missing. Dispatching Architect Designer Sub-Agent...\")\n 209 |                 workflow_file = os.path.join(self.workspace, \"workflow.json\")\n 210 |                 workflow = {\n 211 |                     \"type\": \"JSON_Task\",\n 212 |                     \"status\": \"pending\",\n 213 |                     \"action\": \"execute_agents\",\n 214 |                     \"agents\": [\"architect_designer\"]\n 215 |                 }\n 216 |                 import json\n 217 |                 with open(workflow_file, \"w\") as f:\n 218 |                     json.dump(workflow, f, indent=4)\n 219 |                 print(\"[NodeOS] Workflow payload dropped. Architect worker will bootstrap the project.\")\n 220 | \n 221 |     async def _async_run(self):\n 222 |         # Run the deep scan ingestion immediately before starting the real-time event loop\n 223 |         self.cold_start_ingestion()\n 224 |         \n 225 |         # The raw watchdog runs in the asyncio event loop natively\n 226 |         await self.raw_watchdog.start()\n 227 | \n 228 |     def run(self):\n 229 |         try:\n 230 |             self.loop.run_until_complete(self._async_run())\n 231 |         finally:\n 232 |             self.loop.close()\n 233 | \n 234 | def daemonize_and_run():\n 235 |     if len(sys.argv) > 1 and sys.argv[-1] == '--run-as-daemon':\n 236 |         target_workspace = os.getcwd()\n 237 |         daemon = AGYDaemon(target_workspace)\n 238 |         daemon.run()\n 239 |     else:\n 240 |         print(\"[System] Detaching AGY-NodeOS Daemon (Zero-Dependency) to background process...\")\n 241 |         if os.name == 'nt':\n 242 |             CREATE_NO_WINDOW = 0x08000000\n 243 |             subprocess.Popen([sys.executable, __file__, '--run-as-daemon'], creationflags=CREATE_NO_WINDOW)\n 244 |         else:\n 245 |             log_file = open(os.path.join(os.getcwd(), 'daemon.log'), 'a')\n 246 |        