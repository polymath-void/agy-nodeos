// Copy back to clipboard\n 100 |         await execPromise(`echo ${JSON.stringify(cleaned)} | termux-clipboard-set 2>/dev/null || true`);\n 101 |         await execPromise(\"termux-toast 'Dashboard: Result copied to clipboard!' 2>/dev/null || true\");\n 102 | \n 103 |         res.writeHead(200, { 'Content-Type': 'application/json' });\n 104 |         res.end(JSON.stringify({\n 105 |           input: textToProcess,\n 106 |           result: cleaned\n 107 |         }));\n 108 |       } catch (err) {\n 109 |         res.writeHead(500, { 'Content-Type': 'application/json' });\n 110 |         res.end(JSON.stringify({ error: err.message }));\n 111 |       }\n 112 |     });\n 113 |     return;\n 114 |   }\n 115 | \n 116 |   // Serve Static Files\n 117 |   let filePath = path.join(PUBLIC_DIR, url.pathname === '/' ? 'index.html' : url.pathname);\n 118 |   const ext = path.extname(filePath);\n 119 |   const mimeTypes = {\n 120 |     '.html': 'text/html',\n 121 |     '.css': 'text/css',\n 122 |     '.js': 'text/javascript',\n 123 |     '.json': 'application/json',\n 124 |     '.png': 'image/png',\n 125 |     '.jpg': 'image/jpeg',\n 126 |     '.svg': 'image/svg+xml'\n 127 |   };\n 128 | \n 129 |   fs.readFile(filePath, (err, content) => {\n 130 |     if (err) {\n 131 |       if (err.code === 'ENOENT') {\n 132 |         fs.readFile(path.join(PUBLIC_DIR, 'index.html'), (err2, fallback) => {\n 133 |           res.writeHead(200, { 'Content-Type': 'text/html' });\n 134 |           res.end(fallback);\n 135 |         });\n 136 |       } else {\n 137 |         res.writeHead(500);\n 138 |         res.end(`Server Error: ${err.code}`);\n 139 |       }\n 140 |     } else {\n 141 |       res.writeHead(200, { 'Content-Type': mimeTypes[ext] || 'text/plain' });\n 142 |       res.end(content);\n 143 |     }\n 144 |   });\n 145 | });\n 146 | \n 147 | server.listen(PORT, '0.0.0.0', () => {\n 148 |   console.log(`\ud83d\ude80 [Sentinel Dashboard] Server running at http://127.0.0.1:${PORT}/`);\n 1