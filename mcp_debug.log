SEND: {"jsonrpc": "2.0", "id": 7, "result": {"content": [{"type": "text", "text": "--- FILE: /data/data/com.termux/files/home/Projects/ComputeRes/termux_setup.sh (39 lines) ---\n   1 | #!/data/data/com.termux/files/usr/bin/bash\n   2 | echo \"===================================================\"\n   3 | echo \"\ud83d\ude80 ComputeRes: Native Termux Build Optimizer\"\n   4 | echo \"===================================================\"\n   5 | echo \"\"\n   6 | echo \"[1/4] Installing Native C-Compilers and FFmpeg/WebRTC Headers...\"\n   7 | pkg install -y clang ffmpeg libsrtp python curl wget tar || { echo \"Failed to install dependencies\"; exit 1; }\n   8 | \n   9 | echo \"\"\n  10 | echo \"[2/4] Downloading and Patching PyAV Cython Compiler...\"\n  11 | mkdir -p /tmp/compute_res_pyav && cd /tmp/compute_res_pyav\n  12 | curl -sL https://pypi.org/pypi/av/17.1.0/json | grep -o 'https://[^\"]*\\.tar\\.gz' | head -n 1 | xargs wget -O av.tar.gz\n  13 | tar -xzf av.tar.gz\n  14 | cd av-*\n  15 | \n  16 | # Remove Cython redeclaration of seek_func which crashes Python 3.14 on Termux\n  17 | sed -i 's/seek_func: seek_func_t = pyio_seek/seek_func = pyio_seek/g' av/container/pyio.py\n  18 | \n  19 | echo \"Building PyAV natively (this will take a few minutes)...\"\n  20 | pip install . || { echo \"PyAV compilation failed!\"; exit 1; }\n  21 | \n  22 | echo \"\"\n  23 | echo \"[3/4] Installing ComputeRes and aiortc...\"\n  24 | cd /data/data/com.termux/files/home/Projects/ComputeRes\n  25 | pip install .\n  26 | pip install aiortc\n  27 | \n  28 | echo \"\"\n  29 | echo \"[4/4] Patching Bionic libc for WebRTC NAT Hole-punching...\"\n  30 | # Termux uses Bionic libc.so, but aiortc's ifaddr dependency expects GNU libc.so.6\n  31 | IFADDR_PATH=$(python -c \"import ifaddr, os; print(os.path.dirname(ifaddr.__file__))\")\n  32 | sed -i 's/ctypes.util.find_library(\"socket\" if os.uname()\\[0\\] == \"SunOS\" else \"c\")/\"libc.so\"/g' $IFADDR_PATH/_posix.py\n  33 | \n  34 | echo \"\"\n  35 | echo \"===================================================\"\n  36 | echo \"\u2705 ComputeRes WebRTC Swarm is natively compiled for Termux!\"\n  37 | echo \"Run 'compute_res' to boot the kernel.\"\n  38 | echo \"Run 'python3 -m compute_res.telemetry.core.app' in a separate tab for the TUI Dashboard.\"\n  39 | echo \"===================================================\"\n"}]}}
