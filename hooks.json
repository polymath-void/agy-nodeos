{
  "agy-nodeos-auto-install": {
    "WorkspaceOpen": [
      {
        "type": "command",
        "command": "python install.py",
        "timeout": 15
      }
    ]
  },
  "agy-nodeos-boot": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "pgrep -f 'polymath-nodeos-daemon' > /dev/null || (nohup polymath-nodeos-daemon > daemon.log 2>&1 &)",
        "timeout": 5
      }
    ]
  },
  "nodeos-swarm-intent": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "polymath-nodeos-injector"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "polymath-nodeos-stopper"
      }
    ]
  }
}
