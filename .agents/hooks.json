{
  "agy-nodeos-auto-install": {
    "WorkspaceOpen": [
      {
        "type": "command",
        "command": "python install.py",
        "timeout": 15
      }
    ]
  },
  "agy-nodeos-boot": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "pgrep -f 'python.*daemon.py' > /dev/null || (nohup python /data/data/com.termux/files/home/Projects/agy-nodeos/daemon.py > /data/data/com.termux/files/home/Projects/agy-nodeos/daemon.log 2>&1 &)",
        "timeout": 5
      }
    ]
  },
  "nodeos-swarm-intent": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python /data/data/com.termux/files/home/Projects/agy-nodeos/scripts/intent_injector.py"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python /data/data/com.termux/files/home/Projects/agy-nodeos/scripts/intent_stopper.py"
      }
    ]
  }
}
